@prefix : <http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/> .

<http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4> rdf:type owl:Ontology ;
                                                                          rdfs:comment """Autor:Joan Sebastian Muñoz Bedoya
Sebatian Basto Olaya""" .

#################################################################
#    Object Properties
#################################################################

:alojadoEn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :ContenedorDocker ;
           rdfs:range :ServidorWeb .

:contieneVulnerabilidad rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain :ComponenteInfraestructura ;
                        rdfs:range :VulnerabilidadSeguridad .

:dependeDe rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :ComponenteInfraestructura ;
           rdfs:range :ComponenteInfraestructura .

:ejecutaEn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :API_Microservicio ;
           rdfs:range :ContenedorDocker .

:impactaA rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdfs:domain :Incidente ;
          rdfs:range :ComponenteInfraestructura .

:presentaFalla rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :ComponenteInfraestructura ;
               rdfs:range :FallaTecnica .

:seResuelveCon rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Incidente ;
               rdfs:range :AccionDevSecOps .

#################################################################
#    Data properties
#################################################################

:codigoCVE rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :VulnerabilidadSeguridad ;
           rdfs:range xsd:string .

:comandoCLI rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :AccionDevSecOps ;
            rdfs:range xsd:string .

:direccionIP rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :ComponenteInfraestructura ;
             rdfs:range xsd:string .

:nivelGravedad rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :Incidente ;
               rdfs:range xsd:string .

:puerto rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :ComponenteInfraestructura ;
        rdfs:range xsd:integer .

:tiempoExpiracion rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :UsuarioSeguridad ;
                  rdfs:range xsd:integer .

#################################################################
#    Classes
#################################################################

:API_Microservicio rdf:type owl:Class ;
                   rdfs:subClassOf :ComponenteInfraestructura .

:AccionDevSecOps rdf:type owl:Class .

:Administrador rdf:type owl:Class ;
               rdfs:subClassOf :UsuarioSeguridad .

:BalanceadorCarga rdf:type owl:Class ;
                  rdfs:subClassOf :ComponenteInfraestructura .

:BaseDatos rdf:type owl:Class ;
           rdfs:subClassOf :ComponenteInfraestructura .

:ComandoReparacion rdf:type owl:Class ;
                   rdfs:subClassOf :AccionDevSecOps .

:ComponenteInfraestructura rdf:type owl:Class .

:ContenedorDocker rdf:type owl:Class ;
                  rdfs:subClassOf :ComponenteInfraestructura .

:FallaTecnica rdf:type owl:Class ;
              rdfs:subClassOf :Incidente .

:Incidente rdf:type owl:Class .

:OperadorTI rdf:type owl:Class ;
            rdfs:subClassOf :UsuarioSeguridad .

:ParcheSeguridad rdf:type owl:Class ;
                 rdfs:subClassOf :AccionDevSecOps .

:ScriptDespliegue rdf:type owl:Class ;
                  rdfs:subClassOf :AccionDevSecOps .

:ServidorWeb rdf:type owl:Class ;
             rdfs:subClassOf :ComponenteInfraestructura .

:UsuarioSeguridad rdf:type owl:Class .

:VulnerabilidadSeguridad rdf:type owl:Class ;
                         rdfs:subClassOf :Incidente .

#################################################################
#    Individuals
#################################################################

:API_Analitica rdf:type owl:NamedIndividual ,
                        :API_Microservicio ;
               :dependeDe :BD_Analytics_ClickHouse ;
               :ejecutaEn :Docker_Analytics_Service ;
               :puerto 8005 .

:API_Auditoria rdf:type owl:NamedIndividual ,
                        :API_Microservicio ;
               :dependeDe :BD_Audit_Elasticsearch ;
               :ejecutaEn :Docker_Audit_Service ;
               :puerto 8009 .

:API_Autenticacion rdf:type owl:NamedIndividual ,
                            :API_Microservicio ;
                   :dependeDe :BD_Usuarios_Postgres ;
                   :ejecutaEn :Docker_Auth_Service ;
                   :puerto 8000 .

:API_Busqueda rdf:type owl:NamedIndividual ,
                       :API_Microservicio ;
              :dependeDe :BD_Audit_Elasticsearch ;
              :ejecutaEn :Docker_Search_Service ;
              :puerto 8006 .

:API_Catalogo rdf:type owl:NamedIndividual ,
                       :API_Microservicio ;
              :dependeDe :BD_Catalogo_Mongo ;
              :ejecutaEn :Docker_Catalog_Service ;
              :puerto 8002 .

:API_Envios rdf:type owl:NamedIndividual ,
                     :API_Microservicio ;
            :dependeDe :BD_Ordenes_Postgres ;
            :ejecutaEn :Docker_Shipping_Service ;
            :puerto 8008 .

:API_Facturacion rdf:type owl:NamedIndividual ,
                          :API_Microservicio ;
                 :dependeDe :BD_Pagos_MySQL ;
                 :ejecutaEn :Docker_Payment_Service ;
                 :presentaFalla :Error_HTTP_502_BadGateway ;
                 :puerto 8081 .

:API_Gateway_Central rdf:type owl:NamedIndividual ,
                              :API_Microservicio ;
                     :dependeDe :API_Autenticacion ;
                     :ejecutaEn :Docker_Gateway_Service ;
                     :puerto 443 .

:API_Inventario rdf:type owl:NamedIndividual ,
                         :API_Microservicio ;
                :dependeDe :BD_Catalogo_Mongo ;
                :ejecutaEn :Docker_Inventory_Service ;
                :puerto 8007 .

:API_Logs_Loki rdf:type owl:NamedIndividual ,
                        :API_Microservicio ;
               :ejecutaEn :Docker_Audit_Service ;
               :puerto 3100 .

:API_Metricas_Prometheus rdf:type owl:NamedIndividual ,
                                :API_Microservicio ;
                       :ejecutaEn :Docker_Analytics_Service ;
                       :puerto 9090 .

:API_Notificaciones rdf:type owl:NamedIndividual ,
                             :API_Microservicio ;
                    :ejecutaEn :Docker_Notification_Service ;
                    :puerto 8004 .

:API_Ordenes rdf:type owl:NamedIndividual ,
                      :API_Microservicio ;
             :dependeDe :BD_Ordenes_Postgres ;
             :ejecutaEn :Docker_Order_Service ;
             :puerto 8003 .

:API_Pagos rdf:type owl:NamedIndividual ,
                    :API_Microservicio ;
           :contieneVulnerabilidad :Vuln_OpenSSL_Heartbleed ;
           :dependeDe :BD_Pagos_MySQL ;
           :ejecutaEn :Docker_Payment_Service ;
           :puerto 8080 .

:API_Usuarios rdf:type owl:NamedIndividual ,
                       :API_Microservicio ;
              :dependeDe :BD_Usuarios_Postgres ;
              :ejecutaEn :Docker_User_Service ;
              :puerto 8001 .

