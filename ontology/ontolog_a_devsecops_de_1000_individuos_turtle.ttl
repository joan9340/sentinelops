                  :direccionIP "10.0.1.20" ;
                  :puerto 8200 .

:Docker_Analytics_Service rdf:type owl:NamedIndividual ,
                                   :ContenedorDocker ;
                          :alojadoEn :Servidor_Staging_01 .

:Docker_Audit_Service rdf:type owl:NamedIndividual ,
                               :ContenedorDocker ;
                      :alojadoEn :Servidor_Dev_01 .

:Docker_Auth_Service rdf:type owl:NamedIndividual ,
                              :ContenedorDocker ;
                     :alojadoEn :Servidor_Prod_01 .

:Docker_Catalog_Service rdf:type owl:NamedIndividual ,
                                 :ContenedorDocker ;
                        :alojadoEn :Servidor_Prod_02 .

:Docker_Gateway_Service rdf:type owl:NamedIndividual ,
                                 :ContenedorDocker ;
                        :alojadoEn :Servidor_DMZ_01 .

:Docker_Inventory_Service rdf:type owl:NamedIndividual ,
                                   :ContenedorDocker ;
                          :alojadoEn :Servidor_Staging_02 .

:Docker_Notification_Service rdf:type owl:NamedIndividual ,
                                      :ContenedorDocker ;
                             :alojadoEn :Servidor_Prod_03 .

:Docker_Order_Service rdf:type owl:NamedIndividual ,
                               :ContenedorDocker ;
                      :alojadoEn :Servidor_Prod_03 .

:Docker_Payment_Service rdf:type owl:NamedIndividual ,
                                 :ContenedorDocker ;
                        :alojadoEn :Servidor_Prod_01 .

:Docker_RabbitMQ_Cont rdf:type owl:NamedIndividual ,
                               :ContenedorDocker ;
                      :alojadoEn :Servidor_Prod_03 .

:Docker_Redis_Cache_Cont rdf:type owl:NamedIndividual ,
                                  :ContenedorDocker ;
                         :alojadoEn :Servidor_Prod_02 .

:Docker_Search_Service rdf:type owl:NamedIndividual ,
                                :ContenedorDocker ;
                       :alojadoEn :Servidor_Staging_01 .

:Docker_Shipping_Service rdf:type owl:NamedIndividual ,
                                  :ContenedorDocker ;
                         :alojadoEn :Servidor_Staging_02 .

:Docker_User_Service rdf:type owl:NamedIndividual ,
                              :ContenedorDocker ;
                     :alojadoEn :Servidor_Prod_02 .

:Docker_WAF_Proxy rdf:type owl:NamedIndividual ,
                           :ContenedorDocker ;
                  :alojadoEn :Servidor_DMZ_01 .

:Error_CPU_Throttling_High rdf:type owl:NamedIndividual ,
                                    :FallaTecnica ;
                           :impactaA :Docker_Order_Service ;
                           :seResuelveCon :Fix_Scale_Docker_Replicas ;
                           :nivelGravedad "MEDIO" .

:Error_Conexion_Timeout rdf:type owl:NamedIndividual ,
                                 :FallaTecnica ;
                        :impactaA :API_Autenticacion ;
                        :seResuelveCon :Fix_Reiniciar_Postgres ;
                        :nivelGravedad "CRITICO" .

:Error_DNS_Resolution_Failure rdf:type owl:NamedIndividual ,
                                       :FallaTecnica ;
                              :impactaA :API_Envios ;
                              :seResuelveCon :Fix_Flush_DNS_Cache ;
                              :nivelGravedad "BAJO" .

:Error_Disk_Quota_Exceeded rdf:type owl:NamedIndividual ,
                                    :FallaTecnica ;
                           :impactaA :Servidor_Prod_01 ;
                           :seResuelveCon :Fix_Clean_Docker_Prune ;
                           :nivelGravedad "CRITICO" .

:Error_HTTP_502_BadGateway rdf:type owl:NamedIndividual ,
                                    :FallaTecnica ;
                           :impactaA :API_Facturacion ;
                           :seResuelveCon :Fix_Restart_Nginx ;
                           :nivelGravedad "ALTO" .

:Error_Out_Of_Memory_Killed rdf:type owl:NamedIndividual ,
                                     :FallaTecnica ;
                            :impactaA :Docker_Analytics_Service ;
                            :seResuelveCon :Fix_Increase_Docker_RAM ;
                            :nivelGravedad "ALTO" .

:Error_Postgres_Deadlock rdf:type owl:NamedIndividual ,
                                  :FallaTecnica ;
                         :impactaA :BD_Ordenes_Postgres ;
                         :seResuelveCon :Fix_Kill_Idle_Connections ;
                         :nivelGravedad "ALTO" .

:Error_RabbitMQ_Queue_Blocked rdf:type owl:NamedIndividual ,
                                       :FallaTecnica ;
                              :impactaA :API_Notificaciones ;
                              :seResuelveCon :Fix_Purge_RabbitMQ_Queue ;
                              :nivelGravedad "MEDIO" .

:Error_Redis_Memory_Full rdf:type owl:NamedIndividual ,
                                  :FallaTecnica ;
                         :impactaA :BD_Redis_Cache ;
                         :seResuelveCon :Fix_Flush_Redis ;
                         :nivelGravedad "MEDIO" .

:Error_SSL_Certificate_Expired rdf:type owl:NamedIndividual ,
                                        :FallaTecnica ;
                               :impactaA :Nginx_LB_Frontend ;
                               :seResuelveCon :Fix_Renew_Certbot ;
                               :nivelGravedad "CRITICO" .

:Fix_Actualizar_OpenSSL rdf:type owl:NamedIndividual ,
                                 :ParcheSeguridad ;
                        :comandoCLI "apk upgrade --no-cache openssl" .

:Fix_Clean_Docker_Prune rdf:type owl:NamedIndividual ,
                                 :ComandoReparacion ;
                        :comandoCLI "docker system prune -a --volumes -f" .

:Fix_Enable_Mongo_Auth rdf:type owl:NamedIndividual ,
                                :ParcheSeguridad ;
                       :comandoCLI "mongod --auth --config /etc/mongod.conf" .

:Fix_Enforce_JWT_Alg rdf:type owl:NamedIndividual ,
                              :ParcheSeguridad ;
                     :comandoCLI "sed -i 's/ALG_NONE/ALG_RS256/g' /app/config/jwt.json" .

:Fix_Flush_DNS_Cache rdf:type owl:NamedIndividual ,
                              :ComandoReparacion ;
                     :comandoCLI "resolvectl flush-caches" .

:Fix_Flush_Redis rdf:type owl:NamedIndividual ,
                          :ComandoReparacion ;
                 :comandoCLI "redis-cli flushall" .

:Fix_Increase_Docker_RAM rdf:type owl:NamedIndividual ,
                                  :ComandoReparacion ;
                         :comandoCLI "docker update --memory 4g --memory-swap 4g docker_analytics_cont" .

:Fix_Kill_Idle_Connections rdf:type owl:NamedIndividual ,
                                    :ComandoReparacion ;
                           :comandoCLI "psql -U postgres -c \"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE state = 'idle';\"" .

:Fix_Patch_Log4j rdf:type owl:NamedIndividual ,
                          :ParcheSeguridad ;
                 :comandoCLI "export LOG4J_FORMAT_MSG_NO_LOOKUPS=true && systemctl restart elasticsearch" .

:Fix_Patch_Nginx_HTTP2 rdf:type owl:NamedIndividual ,
                                :ParcheSeguridad ;
                       :comandoCLI "apt-get update && apt-get install --only-upgrade nginx -y" .

:Fix_Purge_RabbitMQ_Queue rdf:type owl:NamedIndividual ,
                                   :ComandoReparacion ;
                          :comandoCLI "rabbitmqctl purge_queue notifications_queue" .

:Fix_Reiniciar_Postgres rdf:type owl:NamedIndividual ,
                                 :ComandoReparacion ;
                        :comandoCLI "docker restart postgres_db_container" .

:Fix_Renew_Certbot rdf:type owl:NamedIndividual ,
                            :ComandoReparacion ;
                   :comandoCLI "certbot renew --force-renewal" .

:Fix_Restart_Nginx rdf:type owl:NamedIndividual ,
                            :ComandoReparacion ;
                   :comandoCLI "systemctl restart nginx" .

:Fix_Sanitize_Gateway_Inputs rdf:type owl:NamedIndividual ,
                                      :ParcheSeguridad ;
                             :comandoCLI "pip install --upgrade bleach html-sanitizer" .

:Fix_Scale_Docker_Replicas rdf:type owl:NamedIndividual ,
                                    :ComandoReparacion ;
                           :comandoCLI "docker service scale order_service=3" .

:Fix_Update_OpenSSH rdf:type owl:NamedIndividual ,
                             :ParcheSeguridad ;
                    :comandoCLI "apt-get update && apt-get install --only-upgrade openssh-server -y" .

:Fix_Update_Postgres_Binary rdf:type owl:NamedIndividual ,
                                     :ParcheSeguridad ;
                            :comandoCLI "apt-get update && apt-get install --only-upgrade postgresql-14 -y" .

:Fix_Update_RunC rdf:type owl:NamedIndividual ,
                          :ParcheSeguridad ;
                 :comandoCLI "curl -L https://github.com/opencontainers/runc/releases/download/v1.1.12/runc.amd64 -o /usr/bin/runc" .

:Fix_Update_Spring_Framework rdf:type owl:NamedIndividual ,
                                      :ParcheSeguridad ;
                             :comandoCLI "./gradlew build -PspringVersion=5.3.18" .

:HAProxy_Core rdf:type owl:NamedIndividual ,
                       :BalanceadorCarga ;
              :direccionIP "192.168.1.3" ;
              :puerto 9000 .

:Nginx_LB_Backend rdf:type owl:NamedIndividual ,
                           :BalanceadorCarga ;
                  :direccionIP "192.168.1.2" ;
                  :puerto 8080 .

:Nginx_LB_Frontend rdf:type owl:NamedIndividual ,
                            :BalanceadorCarga ;
                   :direccionIP "192.168.1.1" ;
                   :puerto 443 .

:Script_Backup_Postgres_Daily rdf:type owl:NamedIndividual ,
                                       :ScriptDespliegue ;
                              :comandoCLI "pg_dump -U postgres -h 192.168.1.20 db_users > /backups/users_$(date +%F).sql" .

:Script_DB_Migration_Run rdf:type owl:NamedIndividual ,
                                  :ScriptDespliegue ;
                         :comandoCLI "alembic upgrade head" .

:Script_Deploy_Prod_Pipeline rdf:type owl:NamedIndividual ,
                                      :ScriptDespliegue ;
                             :comandoCLI "./scripts/deploy_prod.sh --env=production --blue-green" .

:Script_Deploy_Staging rdf:type owl:NamedIndividual ,
                                :ScriptDespliegue ;
                       :comandoCLI "./scripts/deploy_staging.sh --branch=develop" .

:Script_Rollback_Auth rdf:type owl:NamedIndividual ,
                               :ScriptDespliegue ;
                      :comandoCLI "helm rollback auth-service-release 1" .

