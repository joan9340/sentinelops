                :presentaFalla :Error_Redis_Memory_Full ;
                :direccionIP "192.168.1.23" ;
                :puerto 6379 .

:BD_Staging_Postgres rdf:type owl:NamedIndividual ,
                              :BaseDatos ;
                     :direccionIP "192.168.2.20" ;
                     :puerto 5432 .

:BD_Usuarios_Postgres rdf:type owl:NamedIndividual ,
