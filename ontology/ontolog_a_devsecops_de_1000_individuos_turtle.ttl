:Vuln_Docker_Escape_RunC rdf:type owl:NamedIndividual ,
                                  :VulnerabilidadSeguridad ;
                         :impactaA :Docker_Gateway_Service ;
                         :seResuelveCon :Fix_Update_RunC ;
                         :codigoCVE "CVE-2019-5736" ;
                         :nivelGravedad "CRITICO" .

:Vuln_JWT_None_Algorithm rdf:type owl:NamedIndividual ,
                                  :VulnerabilidadSeguridad ;
                         :impactaA :API_Autenticacion ;
                         :seResuelveCon :Fix_Enforce_JWT_Alg ;
                         :codigoCVE "CVE-2022-21449" ;
                         :nivelGravedad "CRITICO" .

:Vuln_Log4j_Elastic rdf:type owl:NamedIndividual ,
                             :VulnerabilidadSeguridad ;
                    :impactaA :BD_Audit_Elasticsearch ;
                    :seResuelveCon :Fix_Patch_Log4j ;
                    :codigoCVE "CVE-2021-44228" ;
                    :nivelGravedad "CRITICO" .

