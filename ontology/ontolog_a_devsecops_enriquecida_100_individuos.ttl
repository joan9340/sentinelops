<http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4> rdf:type owl:Ontology ;
                                                                          rdfs:comment """Autor:Joan Sebastian Muñoz Bedoya
Sebatian Basto Olaya""" .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/alojadoEn
:alojadoEn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :ContenedorDocker ;
           rdfs:range :ServidorWeb .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/contieneVulnerabilidad
:contieneVulnerabilidad rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain :ComponenteInfraestructura ;
                        rdfs:range :VulnerabilidadSeguridad .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/dependeDe
:dependeDe rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :ComponenteInfraestructura ;
           rdfs:range :ComponenteInfraestructura .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/ejecutaEn
:ejecutaEn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :API_Microservicio ;
           rdfs:range :ContenedorDocker .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/impactaA
:impactaA rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdfs:domain :Incidente ;
          rdfs:range :ComponenteInfraestructura .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/presentaFalla
:presentaFalla rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :ComponenteInfraestructura ;
               rdfs:range :FallaTecnica .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/seResuelveCon
:seResuelveCon rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Incidente ;
               rdfs:range :AccionDevSecOps .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/codigoCVE
:codigoCVE rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :VulnerabilidadSeguridad ;
           rdfs:range xsd:string .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/comandoCLI
:comandoCLI rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :AccionDevSecOps ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/direccionIP
:direccionIP rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :ComponenteInfraestructura ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/nivelGravedad
:nivelGravedad rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :Incidente ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/puerto
:puerto rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :ComponenteInfraestructura ;
        rdfs:range xsd:integer .


###  http://www.semanticweb.org/munoz/ontologies/2026/8/untitled-ontology-4/tiempoExpiracion
:tiempoExpiracion rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :UsuarioSeguridad ;
                  rdfs:range xsd:integer .


